# Godot 4+ specific ignores
.godot/

# Local environment settings and credentials
.env

# Godot-specific ignores
[Pp]ublish/

# Imported translations (automatically generated from CSV files)
*.translation

# VS Code specific ignores
.vscode/

# Asset scripts ignores
asset_scripts/spells.csv
asset_scripts/spells2.csv
asset_scripts/spells.txt
asset_scripts/message.txt
asset_scripts/engine_strings/*
__pycache__/
*.py[cod]
asset_scripts/descriptions.json
asset_scripts/expansion_tiles
asset_scripts/The Family Jewels*
asset_scripts/tileset_outdoor.png
asset_scripts/expansion_tiles
.venv/

# Generated local audit reports
tmp/classic-spell-parity-audit.json
tmp/classic-spell-parity-audit.md
tmp/classic-damage-spell-scaffold/


# External addons
src/addons/godot-git-plugin/
src/addons/TilED/
src/addons/godot-openmpt/
src/addons/godot-openmpt.backup.*/
src/addons/rcedit-x64.exe
src/Profiles/Default Profile/Characters/*
src/Profiles/Default Profile/Saves/*
!src/Profiles/Default Profile/Saves/.gitkeep
!src/Profiles/Default Profile/Characters/.gitkeep
