func build_shops() :
	var built_shops : Dictionary = {}
	for d in shops_data_dict.keys() :
		built_shops["shop_"+d] = build_shop_dict_from_data(shops_data_dict[d])
	return built_shops

func get_shop(_shopname : String, _shopdict : Dictionary) :
	return _shopdict

func build_shop_dict_from_data(data : Dictionary) -> Dictionary :
	var weapons : Array = []
	if data.has("weapons") :
		for i in data["weapons"] :
			weapons.append([i[0], i[1], -1])
	var body_armor : Array = []
	if data.has("armor1") :
		for i in data["armor1"] :
			body_armor.append([i[0], i[1], -1])
	var limb_armor : Array = []
	if data.has("armor2") :
		for i in data["armor2"] :
			limb_armor.append([i[0], i[1], -1])
	var magic_items : Array = []
	if data.has("magic") :
		for i in data["magic"] :
			magic_items.append([i[0], i[1], -1])
	var supplies : Array = []
	if data.has("items") :
		for i in data["items"] :
			supplies.append([i[0], i[1], -1])
	var inflation = data["inflation"] + 1.0
	return {"buy_rate":1.0, "sell_rate":inflation, "Weapons" : weapons, "Armor" : body_armor, "Limbs" : limb_armor, "Magic" : magic_items, "Supplies" : supplies, "BuyBack" : []}
