[connection signal="pressed" from="HBoxContainer/SkillsButton/UseSkillRect/skillchanceContainer/skillContainer/PickSkillButt" to="HBoxContainer/SkillsButton/UseSkillRect" method="_on_skillbutton_pressed" binds= ["Pick_Lock"]]
[connection signal="pressed" from="HBoxContainer/SpeakButton" to="." method="_on_SpeakButton_pressed"]
