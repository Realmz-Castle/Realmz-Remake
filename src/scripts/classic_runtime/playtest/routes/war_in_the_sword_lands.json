      "sequence": [
        {"kind": "message", "id": 3921, "prefix": "You find Primus standing before a large gateway."},
        {"kind": "message", "id": 3922, "prefix": "As you walk ahead to attack him"},
        {"kind": "message", "id": 3923, "prefix": "He chuckles."},
        {"kind": "message", "id": 3924, "prefix": "He sighs, gazing upwards"},
        {"kind": "message", "id": 3925, "prefix": "\"Stop this madness now, Primus!"},
        {"kind": "message", "id": 3926, "prefix": "\"Primus?"},
        {"kind": "message", "id": 3927, "prefix": "She turns to you with alarm"},
        {"kind": "message", "id": 3932, "prefix": "\"In effect, it was not Primus"},
        {"kind": "message", "id": 3933, "prefix": "\"But THE Mentarch!"},
        {"kind": "message", "id": 3934, "prefix": "As Primus/Maximus laughs anew"},
        {"kind": "message", "id": 3935, "prefix": "You turn around to face the telekinetic field"},
        {"kind": "message", "id": 3936, "prefix": "\"Time for me to go"},
        {"kind": "message", "id": 3937, "prefix": "Primus/Maximus sighs."},
        {"kind": "message", "id": 3938, "prefix": "\"From my demise twelve thousand years ago"},
        {"kind": "message", "id": 4068, "prefix": "\"How eager he was to accept me!"},
        {"kind": "message", "id": 4069, "prefix": "Mentarchs!"},
        {"kind": "message", "id": 4070, "prefix": "and so I ingratiated them"},
        {"kind": "message", "id": 4071, "prefix": "it never really mattered"},
        {"kind": "message", "id": 3939, "prefix": "\"So you see, my little Overlords"},
        {"kind": "message", "id": 3940, "prefix": "fully functional state"},
        {"kind": "message", "id": 3941, "prefix": "He shakes his head."},
        {"kind": "message", "id": 3942, "prefix": "casting a cloud over my triumphant moment"},
        {"kind": "message", "id": 3943, "prefix": "At these words, Primus/Maximus lowers"},
        {"kind": "message", "id": 3944, "prefix": "In an instant, Naryl rushes ahead"},
        {"kind": "message", "id": 3945, "prefix": "Engulfed by the tremendous psionic energies"},
        {"kind": "message", "id": 3946, "prefix": "Before you can regain your bearings"},
        {"kind": "message", "id": 3947, "prefix": "Confused, you run to Naryl's side."},
        {"kind": "message", "id": 3948, "prefix": "Naryl lies on the floor"},
        {"kind": "message", "id": 3949, "prefix": "\"Both mind and body"},
        {"kind": "message", "id": 3949, "prefix": "\"Both mind and body"},
        {"kind": "message", "id": 3951, "prefix": "\"Goodbye"},
