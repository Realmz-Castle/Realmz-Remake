		},
		{
			"kind": "message",
			"messageId": 3904,
			"prefix": "Entering the citadel, you are awed",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3905,
			"prefix": "Looking up, you are startled",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3906,
			"prefix": "A familiar voice calling out",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3908,
			"prefix": "\"Says who?",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3909,
			"prefix": "\"I swore an oath",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3910,
			"prefix": "\"You are a misguided fool",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3911,
			"prefix": "\"Aye. That is what our people refuse to see.",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3912,
			"prefix": "\"Well spoken, Master Sark.",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3913,
			"prefix": "\"Therefore, why deny this?",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3914,
			"prefix": "\"We need not bow",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3915,
			"prefix": "\"It's you who are blind!",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3916,
			"prefix": "\"The Mind Lords care about nothing",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3917,
			"prefix": "\"And that is why I have sworn",
			"stepId": "overlord-last-stand"
		},
		{
			"battleId": 212,
			"kind": "battle",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3918,
			"prefix": "A battered and bloodied Naryl",
			"stepId": "overlord-last-stand"
		},
		{
			"kind": "message",
			"messageId": 3921,
			"prefix": "You find Primus standing before a large gateway.",
			"stepId": "maximus-revelation"
