		},
		{
			"kind": "message",
			"messageId": 3181,
			"prefix": "A swordswoman walks up to you",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3182,
			"prefix": "Since this name is far from being common knowledge",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3183,
			"prefix": "Upon hearing this, you can't help but gape in surprise",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3184,
			"prefix": "In fact, tales make good mention",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3186,
			"prefix": "\"It is still very hard for me to be reminded",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3185,
			"prefix": "\"My sources and contacts keep me well informed.",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3149,
			"prefix": "You nod gravely.",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3150,
			"prefix": "\"Then I heard news of the war in the Sword Lands.",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3151,
			"prefix": "Naryl then sighs",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3152,
			"prefix": "\"At least I managed to discover their identities",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3156,
			"prefix": "\"I also found out where some of them are operating!",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3153,
			"prefix": "With grim satisfaction, you tell Naryl",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3169,
			"prefix": "\"Well that is a relief!",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3159,
			"prefix": "\"In any case, that is useful information",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3160,
			"prefix": "You gasp with shock and dread",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3161,
			"prefix": "\"Unfortunately,\" Naryl goes on",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3162,
			"prefix": "She sighs.",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3163,
			"prefix": "\"But most importantly, we must find Primus",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3164,
			"prefix": "\"However, I'm quite aware",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3165,
			"prefix": "Naryl Thezzat has joined your party",
			"stepId": "recruit-naryl"
		},
		{
			"kind": "message",
			"messageId": 3561,
			"prefix": "You find yourselves facing Anthraxus Storm.",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3562,
			"prefix": "\"We meet again.",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3563,
			"prefix": "\"Don't you know by now",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3527,
			"prefix": "\"Your clever tongue won't save you",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3528,
			"prefix": "\"You are a fraud!",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3530,
			"prefix": "\"You know, Naerun",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3531,
			"prefix": "\"As I was saying",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3532,
			"prefix": "\"Despite, I might add",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3533,
			"prefix": "Naerun shakes his head angrily.",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3534,
			"prefix": "\"I will liberate Sharranth from despotism!",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3529,
			"prefix": "\"Such a waste.",
			"stepId": "battle-of-sharranth"
		},
		{
			"battleId": 473,
			"kind": "battle",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3535,
			"prefix": "\"Very well, then!",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3536,
			"prefix": " As you are about to engage the warlord",
			"stepId": "battle-of-sharranth"
		},
		{
			"battleId": 474,
			"kind": "battle",
			"stepId": "battle-of-sharranth"
		},
		{
			"kind": "message",
			"messageId": 3567,
			"prefix": "\"Welcome back, noble ones!",
			"stepId": "naerun-war-ending"
		},
		{
			"kind": "message",
			"messageId": 3568,
			"prefix": "\"Thanks to your valiant efforts",
			"stepId": "naerun-war-ending"
		},
		{
			"kind": "message",
