		{
			"kind": "message",
			"messageId": 39,
			"prefix": "(Thank you for having played Trouble in the Sword Lands!",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 12,
			"prefix": "Nearly six full moons have passed since your heroic adventuring band",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 13,
			"prefix": "But the Overlords' designs went beyond simple conquest",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 16,
			"prefix": "So it was understandable when everyone breathed a sigh of relief",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 17,
			"prefix": "And all were quite content to go back to their normal lives",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 18,
			"prefix": "which promised the coming of an all-out war in the Sword Lands",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 19,
			"prefix": "you felt certain that the Overlord Conspiracy was far from over",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 20,
			"prefix": "A mere sevenday ago, you were sadly proven right",
			"stepId": "war-opening"
		},
		{
			"kind": "message",
			"messageId": 21,
			"prefix": "After days of evading and fighting sharranthine patrols",
