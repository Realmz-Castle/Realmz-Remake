			"prefix": "He sighs, gazing upwards",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3925,
			"prefix": "\"Stop this madness now, Primus!",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3926,
			"prefix": "\"Primus?",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3927,
			"prefix": "She turns to you with alarm",
