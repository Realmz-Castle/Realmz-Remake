		},
		{
			"kind": "message",
			"messageId": 3935,
			"prefix": "You turn around to face the telekinetic field",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3936,
			"prefix": "\"Time for me to go",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3937,
			"prefix": "Primus/Maximus sighs.",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3938,
			"prefix": "\"From my demise twelve thousand years ago",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 4068,
			"prefix": "\"How eager he was to accept me!",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 4069,
			"prefix": "Mentarchs!",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 4070,
			"prefix": "and so I ingratiated them",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 4071,
			"prefix": "it never really mattered",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3939,
			"prefix": "\"So you see, my little Overlords",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3940,
			"prefix": "fully functional state",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3941,
			"prefix": "He shakes his head.",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3942,
			"prefix": "casting a cloud over my triumphant moment",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3943,
			"prefix": "At these words, Primus/Maximus lowers",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3944,
			"prefix": "In an instant, Naryl rushes ahead",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3945,
			"prefix": "Engulfed by the tremendous psionic energies",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3946,
			"prefix": "Before you can regain your bearings",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3947,
			"prefix": "Confused, you run to Naryl's side.",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3948,
			"prefix": "Naryl lies on the floor",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3949,
			"prefix": "\"Both mind and body",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3949,
			"prefix": "\"Both mind and body",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3951,
			"prefix": "\"Goodbye",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3952,
			"prefix": "Alone, you rise",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3953,
			"prefix": "Were all your accomplishments truly futile?",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3954,
			"prefix": "Grieving for Naryl",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3955,
			"prefix": "Have you really won for now",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3960,
			"prefix": "In response, a proverb comes to your mind",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3961,
			"prefix": "(Congratulations for completing the main story-arc",
			"stepId": "maximus-revelation"
		},
		{
			"kind": "message",
			"messageId": 3962,
			"prefix": "(We thank you for registering this second installment",
			"stepId": "maximus-revelation"
		}
