onfidence":"source-backed"}},{"id":462,"values":[-1,1,1,699,0],"provenance":{"sourceFile":"Data EDCD","recordIndex":462,"byteOffset":4620,"byteLength":10,"confidence":"source-backed"}},{"id":607,"values":[0,1,36,74,-4],"provenance":{"sourceFile":"Data EDCD","recordIndex":607,"byteOffset":6070,"byteLength":10,"confidence":"source-backed"}},{"id":639,"values":[5,6,83,0,0],"provenance":{"sourceFile":"Data EDCD","recordIndex":639,"byteOffset":6390,"byteLength":10,"confidence":"source-backed"}},{"id":643,"values":[1,1,0,0,0],"provenance":{"sourceFile":"Data EDCD","recordIndex":643,"byteOffset":6430,"byteLength":10,"confidence":"source-backed"}},{"id":645,"values":[250,0,-1,0,0],"provenance":{"sourceFile":"Data EDCD","recordIndex":645,"byteOffset":6450,"byteLength":10,"confidence":"source-backed"}},{"id":655,"values":[2,1,0,0,0],"provenance":{"sourceFile":"Data EDCD","recordIndex":655,"byteOffset":6550,"byteLength":10,"confidence":"source-backed"}},{"id":659,"values":[10,0,0,0,1],"provenance":{"sourceFile":"Data EDCD","recordIndex":659,"byteOffset":6590,"byteLength":10,"confidence":"source-backed"}},{"id":660,"values":[0,0,33,72,2],"provenance":{"sourceFile":"Data EDCD","recordIndex":660,"byteOffset":6600,"byteLength":10,"confidence":"source-backed"}},{"id":661,"values":[1,0,88,48,0],"provenance":{"sourceFile":"Data EDCD","recordIndex":661,"byteOffset":6610,"byteLength":10,"confidence":"source-backed"}}],"messages":[{"id":0,"text":"Do Not Use","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":0,"byteOffset":0,"byteLength":256,"confidence":"source-backed"}},{"id":1,"text":"You detect no signs of a trap.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":1,"byteOffset":256,"byteLength":256,"confidence":"source-backed"}},{"id":2,"text":"You have checked the lock and are sure that it is not trapped.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":2,"byteOffset":512,"byteLength":256,"confidence":"source-backed"}},{"id":3,"text":"You have failed to pick the lock.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":3,"byteOffset":768,"byteLength":256,"confidence":"source-backed"}},{"id":4,"text":"The lock is now open.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":4,"byteOffset":1024,"byteLength":256,"confidence":"source-backed"}},{"id":5,"text":"You have been successful at disarming the trap.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":5,"byteOffset":1280,"byteLength":256,"confidence":"source-backed"}},{"id":6,"text":"You have failed to disarm the trap.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":6,"byteOffset":1536,"byteLength":256,"confidence":"source-backed"}},{"id":7,"text":"Your inspection has detected a trap!","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":7,"byteOffset":1792,"byteLength":256,"confidence":"source-backed"}},{"id":207,"text":"You see a small notch carved into the wall.  It holds an iron chest bolted to the wall.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":207,"byteOffset":52992,"byteLength":256,"confidence":"source-backed"}},{"id":209,"text":"With the trap triggered, the lock is quickly defeated.  Inside, you find treasure.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":209,"byteOffset":53504,"byteLength":256,"confidence":"source-backed"}},{"id":210,"text":"You hear a click as a trap disarms and the lock opens.  Inside you find treasure.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":210,"byteOffset":53760,"byteLength":256,"confidence":"source-backed"}},{"id":218,"text":"The door to this chamber is locked.  It is made of quite solid oak.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":218,"byteOffset":55808,"byteLength":256,"confidence":"source-backed"}},{"id":50,"text":"You enter the guard house outside the main gate to Castle Anthrax.  Several guards keep a wary eye on you as you approach the head Magistrate.  He is a stately looking man in fine robes.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":50,"byteOffset":12800,"byteLength":256,"confidence":"source-backed"}},{"id":51,"text":"Judging by the man's large girth, robes are not all he fancies.  You approach his fine oak desk.  \"Present your invitation so I may validate it for passage to yon castle.\"","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":51,"byteOffset":13056,"byteLength":256,"confidence":"source-backed"}},{"id":75,"text":"You have entered a rather fine tavern filled with only the best citizens of Bywater.  Most of the tables are filled with patrons eating spiced potatoes and engaged in interesting discussions.  You find yourself a table near the back.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":75,"byteOffset":19200,"byteLength":256,"confidence":"source-backed"}},{"id":76,"text":"You are standing in a tavern.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":76,"byteOffset":19456,"byteLength":256,"confidence":"source-backed"}},{"id":86,"text":"\"Oh, I don't really know much.\"  She smiles and points to the seedy looking man.  \"Ask him, he's been telling me all kinds of stories all day.\"","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":86,"byteOffset":22016,"byteLength":256,"confidence":"source-backed"}},{"id":91,"text":"They make for the door in haste, yelling, \"Targ the thief has gotten his due! Any man who follows us shall join him in Hades!\"  Apparently, they did not see the slip of paper Targ gave you.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":91,"byteOffset":23296,"byteLength":256,"confidence":"source-backed"}},{"id":94,"text":"You are at your table when the town guards show up.  Luckily, nobody wants to get so involved as to implicate you in any manner.  The guards bind Targ's arms to his chest and drag him from the inn.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":94,"byteOffset":24064,"byteLength":256,"confidence":"source-backed"}},{"id":95,"text":"As you examine the slip of paper, you see that it's a map describing the location of an old crypt in the graveyard.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":95,"byteOffset":24320,"byteLength":256,"confidence":"source-backed"}},{"id":620,"text":"You enter the slave prison.  A potbellied Corporal Sampson is slumped over a shaky table.  He's slept through the entire ordeal that just took place outside.  The smell of elderberry wine permeates his clothes.  You try to rouse him to collect your fee.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":620,"byteOffset":158720,"byteLength":256,"confidence":"source-backed"}},{"id":61,"text":"He bids you farewell as you make your way from the gate house.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":61,"byteOffset":15616,"byteLength":256,"confidence":"source-backed"}},{"id":69,"text":"The town patrol waves you through as they hand you a map showing where you can buy provisions.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":69,"byteOffset":17664,"byteLength":256,"confidence":"source-backed"}},{"id":180,"text":"This appears to be the site of a rather large cavern that has recently caved in.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":180,"byteOffset":46080,"byteLength":256,"confidence":"source-backed"}},{"id":183,"text":"You have succeeded in uncovering the passage behind the cave-in.  It is now  possible to traverse the passage to wherever it may take you.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":183,"byteOffset":46848,"byteLength":256,"confidence":"source-backed"}},{"id":185,"text":"The tunnel continues west.  You smell decaying flesh.  The odor is almost overwhelming.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":185,"byteOffset":47360,"byteLength":256,"confidence":"source-backed"}},{"id":241,"text":"After the thrashing you gave the creatures at the gate before, the gate is now only lightly guarded.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":241,"byteOffset":61696,"byteLength":256,"confidence":"source-backed"}},{"id":238,"text":"This is the gate to enter the Spider Tower.  Herein dwells an evil cult bent on total dominance of the world by arachnids and others of their ilk.  The gates are massive, and the walls are guarded by fierce creatures.  Do you wish to attack?","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":238,"byteOffset":60928,"byteLength":256,"confidence":"source-backed"}},{"id":240,"text":"You have managed to battle your way past the gate.  Something tells you that the tough battles are yet to come.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":240,"byteOffset":61440,"byteLength":256,"confidence":"source-backed"}},{"id":678,"text":"You are overcome by a bout of dizziness.  For some inexplicable reason, your compass appears unable to provide you with an accurate reading.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":678,"byteOffset":173568,"byteLength":256,"confidence":"source-backed"}},{"id":848,"text":"You can now see in the dim light.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":848,"byteOffset":217088,"byteLength":256,"confidence":"source-backed"}},{"id":849,"text":"The light fades leaving you in darkness.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":849,"byteOffset":217344,"byteLength":256,"confidence":"source-backed"}},{"id":520,"text":"You see the remains of yet another small child.  Blood still trickles from a jugular  recently opened to let this innocent child's life leak away.  Do you wish to dig the child a grave.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":520,"byteOffset":133120,"byteLength":256,"confidence":"source-backed"}},{"id":521,"text":"That will be one foul meal that shall go untasted.  Whatever could prey on helpless farmers and small children deserves this grave far more than this poor child.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":521,"byteOffset":133376,"byteLength":256,"confidence":"source-backed"}},{"id":522,"text":"As you are leaving the cave you hear a loud roar behind you.  It comes from where you found the small child.  As you attempt to determine the identity of the creatures you see a group of large trolls running in your direction on flapping feet.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":522,"byteOffset":133632,"byteLength":256,"confidence":"source-backed"}},{"id":15,"text":"Who is so brave as to volunteer?","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":15,"byteOffset":3840,"byteLength":256,"confidence":"source-backed"}},{"id":376,"text":"The floor opens up underneath you.  Those that do not perform an acrobatic act, fall in and take damage.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":376,"byteOffset":96256,"byteLength":256,"confidence":"source-backed"}},{"id":377,"text":"You quickly scale the rough sides of the pit and get out.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":377,"byteOffset":96512,"byteLength":256,"confidence":"source-backed"}},{"id":450,"text":"Upon kneeling on the symbols, a magical display of energy sweeps across the floor. Energy beams of light in a myriad of colors appear from all directions.  They strike all those not within the symbols.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":450,"byteOffset":115200,"byteLength":256,"confidence":"source-backed"}},{"id":451,"text":"After the discharge of light beams, the protective energy field vanishes.  Inside the sphere, the vortex of mist forms the visage of a hideous beast.  It stares intently into your eyes and begins to communicate telepathically.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":451,"byteOffset":115456,"byteLength":256,"confidence":"source-backed"}},{"id":506,"text":"At the bottom of the shaft is a large pile of gold coins.  Do you wish to take them?","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":506,"byteOffset":129536,"byteLength":256,"confidence":"source-backed"}},{"id":508,"text":"Large rocks break loose from the ceiling.  Those who are not quick enough fail to get out of the way and take damage.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":508,"byteOffset":130048,"byteLength":256,"confidence":"source-backed"}},{"id":560,"text":"Large boulders careen downwards from a ridge above.  Those not fast enough to avoid the rocks are crushed beneath a hail of missiles.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":560,"byteOffset":143360,"byteLength":256,"confidence":"source-backed"}},{"id":561,"text":"The hail of boulders forces you to take up a defensive position.  Gnath seize the opportunity to close ranks and attack.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":561,"byteOffset":143616,"byteLength":256,"confidence":"source-backed"}},{"id":562,"text":"They carried little of value.  This was a perfect position for setting up an ambush.  Be careful of similar attacks in the future.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":562,"byteOffset":143872,"byteLength":256,"confidence":"source-backed"}},{"id":698,"text":"As soon as you step into the hidden passage, you are assaulted by a mental attack.  It is a psychic barrier used to prevent weak-minded Dogre from entering this area of the fortress.  Your magical energy drains from your body.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":698,"byteOffset":178688,"byteLength":256,"confidence":"source-backed"}},{"id":867,"text":"You arrived in Bywater just in time as a winter storm has just covered the entire region in a thick blanket of snow.","authored":false,"provenance":{"sourceFile":"Data SD2","recordIndex":867,"byteOffset":221952,"byteLength":256,"confidence":"source-backed"}}],"randomLevels":[{"id":"land:0:randlevel","isDark":false,"landlook":0,"levelIndex":0,"levelType":"land","source":"Data RD","useLos":false,"rects":[],"provenance":{"sourceFile":"Data RD","recordIndex":0,"byteOffset":0,"byteLength":644,"confidence":"source-backed"}},{"id":"land:1:randlevel","isDark":true,"landlook":3,"levelIndex":1,"levelType":"land","source":"Data RD","useLos":true,"rects":[{"battleRange":[158,162],"bottom":90,"left":4,"only":false,"option":0,"percent":0,"randomDoorPercent":[0,0,0],"randomDoors":[0,0,0],"rectIndex":17,"right":29,"sound":117,"text":0,"top":60}],"provenance":{"sourceFile":"Data RD","recordIndex":1,"byteOffset":644,"byteLength":644,"confidence":"source-backed"}},{"id":"land:4:randlevel","isDark":false,"landlook":4,"levelIndex":4,"levelType":"land","source":"Data RD","useLos":true,"rects":[],"provenance":{"sourceFile":"Data RD","recordIndex":4,"byteOffset":2576,"byteLength":644,"confidence":"source-backed"}}],"optionLabels":[]}
